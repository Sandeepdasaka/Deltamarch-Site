---
// Envelope button in the header that opens a webmail login dialog.
// The form posts the email address and password straight to the cPanel
// webmail login (the same fields its own login page uses), so the website
// never sees the credentials. Webmail opens in a new tab.
import { company } from '../data/site';
---

<button type="button" class="webmail-btn" aria-haspopup="dialog" aria-controls="webmail-dialog" data-webmail-open>
  <svg width="20" height="20" viewBox="0 0 24 24" fill="none" aria-hidden="true">
    <rect x="3" y="5" width="18" height="14" rx="2.5" stroke="currentColor" stroke-width="1.6" />
    <path d="M4 7l8 6 8-6" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round" />
  </svg>
  <span class="visually-hidden">Webmail login</span>
</button>

<dialog class="webmail" id="webmail-dialog" aria-labelledby="webmail-title" data-webmail-dialog>
  <form
    class="webmail__form"
    action={`${company.webmailUrl}login/`}
    method="post"
    target="_blank"
    autocomplete="on"
    data-webmail-form
  >
    <div class="webmail__head">
      <h2 id="webmail-title">Webmail login</h2>
      <button type="button" class="webmail__close" data-webmail-close>
        <svg width="16" height="16" viewBox="0 0 16 16" aria-hidden="true">
          <path d="M3 3l10 10M13 3L3 13" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" />
        </svg>
        <span class="visually-hidden">Close</span>
      </button>
    </div>
    <p class="webmail__lead">Sign in to your Deltamarch email account.</p>

    <input type="hidden" name="goto_uri" value="/" />

    <div class="field">
      <label for="webmail-user">Email address</label>
      <input
        id="webmail-user"
        name="user"
        type="email"
        autocomplete="username"
        placeholder="name@deltamarch.in"
        required
      />
    </div>
    <div class="field">
      <label for="webmail-pass">Password</label>
      <input id="webmail-pass" name="pass" type="password" autocomplete="current-password" required />
    </div>

    <button type="submit" class="btn webmail__submit">Log in</button>
    <p class="webmail__note">
      Opens webmail in a new tab. Trouble signing in?{' '}
      <a href={company.webmailUrl} target="_blank" rel="noopener">Go to the webmail page</a>.
    </p>
  </form>
</dialog>

<style>
  .webmail-btn {
    display: inline-grid;
    place-items: center;
    width: 42px;
    height: 42px;
    border: 1px solid var(--line-dark-strong);
    border-radius: 999px;
    background: rgba(255, 255, 255, 0.04);
    color: var(--on-dark);
    cursor: pointer;
    transition: border-color 0.2s, background-color 0.2s;
  }

  .webmail-btn:hover {
    border-color: rgba(255, 255, 255, 0.5);
    background: rgba(255, 255, 255, 0.08);
  }

  .webmail {
    width: min(420px, calc(100vw - 32px));
    padding: 0;
    border: 0;
    border-radius: var(--radius);
    background: var(--white);
    color: var(--text);
    box-shadow: 0 40px 100px -30px rgba(5, 10, 20, 0.6);
  }

  .webmail::backdrop {
    background: rgba(5, 10, 20, 0.6);
    backdrop-filter: blur(4px);
  }

  .webmail__form {
    display: grid;
    gap: 18px;
    padding: 28px;
  }

  .webmail__head {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 16px;
  }

  .webmail__head h2 {
    font-size: 22px;
    letter-spacing: -0.02em;
  }

  .webmail__close {
    display: inline-grid;
    place-items: center;
    width: 36px;
    height: 36px;
    margin-right: -8px;
    border: 0;
    border-radius: 999px;
    background: none;
    color: var(--muted);
    cursor: pointer;
  }

  .webmail__close:hover {
    background: var(--paper);
    color: var(--text);
  }

  .webmail__lead {
    margin-top: -10px;
    font-size: 15px;
    color: var(--muted);
  }

  .field {
    display: grid;
    gap: 8px;
  }

  .field label {
    font-size: 14px;
    font-weight: 560;
  }

  .field input {
    width: 100%;
    min-height: 50px;
    padding: 12px 16px;
    border: 1px solid var(--line-strong);
    border-radius: var(--radius-sm);
    background: var(--white);
    color: var(--text);
    font: inherit;
    font-size: 16px;
  }

  .field input:focus {
    outline: none;
    border-color: var(--accent-ink);
    box-shadow: 0 0 0 4px rgba(91, 140, 255, 0.18);
  }

  .webmail__submit {
    width: 100%;
    margin-top: 4px;
  }

  .webmail__note {
    font-size: 13.5px;
    color: var(--muted);
  }

  .webmail__note a {
    text-decoration: underline;
  }
</style>

<script>
  const dialog = document.querySelector<HTMLDialogElement>('[data-webmail-dialog]')!;
  const form = dialog.querySelector<HTMLFormElement>('[data-webmail-form]')!;
  const close = () => dialog.close();

  document.querySelectorAll('[data-webmail-open]').forEach((button) =>
    button.addEventListener('click', () => {
      dialog.showModal();
      dialog.querySelector<HTMLInputElement>('#webmail-user')!.focus();
    }),
  );
  dialog.querySelector('[data-webmail-close]')!.addEventListener('click', close);
  // Clicking the dimmed area outside the box closes it.
  dialog.addEventListener('click', (event) => {
    if (event.target === dialog) close();
  });
  // Once submitted, the login continues in the new tab: clear the password and close.
  form.addEventListener('submit', () => {
    setTimeout(() => {
      form.querySelector<HTMLInputElement>('#webmail-pass')!.value = '';
      close();
    }, 0);
  });
</script>
